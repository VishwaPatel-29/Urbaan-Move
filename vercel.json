{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "server/server.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/server/server.js" },
    { "source": "/assets/:path*", "destination": "/client/assets/:path*" },
    { "source": "/favicon.svg", "destination": "/client/favicon.svg" },
    { "source": "/logo.svg", "destination": "/client/logo.svg" },
    { "source": "/sitemap.xml", "destination": "/client/sitemap.xml" },
    { "source": "/og-image.png", "destination": "/client/og-image.png" },
    { "source": "/:path*", "destination": "/client/index.html" }
  ]
}
