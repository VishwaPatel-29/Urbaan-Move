{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "server/server.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server/server.js"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/client/assets/$1"
    },
    {
      "source": "/favicon.svg",
      "destination": "/client/favicon.svg"
    },
    {
      "source": "/logo.svg",
      "destination": "/client/logo.svg"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/client/sitemap.xml"
    },
    {
      "source": "/((?!api|assets|favicon\\.svg|logo\\.svg|sitemap\\.xml).*)",
      "destination": "/client/index.html"
    }
  ]
}
